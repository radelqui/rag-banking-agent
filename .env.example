# Inyectado por CI/CD / Kubernetes Secrets. NUNCA commitear valores reales.
APP_DATABASE_URL=postgresql+asyncpg://app_user:changeme@localhost:5432/banco
LLAMAINDEX_DATABASE_URL=postgresql+asyncpg://ai_readonly:changeme@localhost:5432/banco

# Modelos de frontera. En el banco NO se sale a internet: *_BASE_URL apunta a su pasarela interna.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBED_MODEL=text-embedding-3-small

# Identidad: cabecera que rellena el API gateway del banco tras autenticar (OAuth2/AD)
IDENTITY_HEADER=X-Customer-Id

EMBED_DIM=1536
VECTOR_TABLE=documentos_bancarios
LLM_TIMEOUT_SECONDS=60
